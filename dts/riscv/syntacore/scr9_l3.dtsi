#include <mem.h>

/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <timebase_freq:1000000>;

		cpu0: cpu@0 {
			device_type = cpu0_devtype:"cpu";
			reg = <0>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu0_freq:0>;

			d-cache-block-size = <cpu0_dcbs: 16>;
			d-cache-sets = <cpu0_dcs: 512>;
			d-cache-size = <cpu0_dcsz: 32768>;
			i-cache-block-size = <cpu0_icbs: 16>;
			i-cache-sets = <cpu0_ics: 512>;
			i-cache-size = <cpu0_icsz: 32768>;

			next-level-cache = <&L2>;
		};
		
		cpu1: cpu@1 {
			device_type = cpu1_devtype:"cpu";
			reg = <1>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu1_freq:0>;

			d-cache-block-size = <cpu1_dcbs: 16>;
			d-cache-sets = <cpu1_dcs: 512>;
			d-cache-size = <cpu1_dcsz: 32768>;
			i-cache-block-size = <cpu1_icbs: 16>;
			i-cache-sets = <cpu1_ics: 512>;
			i-cache-size = <cpu1_icsz: 32768>;

			next-level-cache = <&L2>;
		};
		
		cpu2: cpu@2 {
			device_type = cpu2_devtype:"cpu";
			reg = <2>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu2_freq:0>;

			d-cache-block-size = <cpu2_dcbs: 16>;
			d-cache-sets = <cpu2_dcs: 512>;
			d-cache-size = <cpu2_dcsz: 32768>;
			i-cache-block-size = <cpu2_icbs: 16>;
			i-cache-sets = <cpu2_ics: 512>;
			i-cache-size = <cpu2_icsz: 32768>;

			next-level-cache = <&L2>;
		};

		cpu3: cpu@3 {
			device_type = cpu3_devtype:"cpu";
			reg = <3>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu3_freq:0>;

			d-cache-block-size = <cpu3_dcbs: 16>;
			d-cache-sets = <cpu3_dcs: 512>;
			d-cache-size = <cpu3_dcsz: 32768>;
			i-cache-block-size = <cpu3_icbs: 16>;
			i-cache-sets = <cpu3_ics: 512>;
			i-cache-size = <cpu3_icsz: 32768>;

			next-level-cache = <&L2>;
		};

		cpu4: cpu@4 {
			device_type = cpu4_devtype:"cpu";
			reg = <4>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu4_freq:0>;

			d-cache-block-size = <cpu4_dcbs: 16>;
			d-cache-sets = <cpu4_dcs: 512>;
			d-cache-size = <cpu4_dcsz: 32768>;
			i-cache-block-size = <cpu4_icbs: 16>;
			i-cache-sets = <cpu4_ics: 512>;
			i-cache-size = <cpu4_icsz: 32768>;

			next-level-cache = <&L2>;
		};

		cpu5: cpu@5 {
			device_type = cpu5_devtype:"cpu";
			reg = <5>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu5_freq:0>;

			d-cache-block-size = <cpu5_dcbs: 16>;
			d-cache-sets = <cpu5_dcs: 512>;
			d-cache-size = <cpu5_dcsz: 32768>;
			i-cache-block-size = <cpu5_icbs: 16>;
			i-cache-sets = <cpu5_ics: 512>;
			i-cache-size = <cpu5_icsz: 32768>;

			next-level-cache = <&L2>;
		};

		cpu6: cpu@6 {
			device_type = cpu6_devtype:"cpu";
			reg = <6>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu6_freq:0>;

			d-cache-block-size = <cpu6_dcbs: 16>;
			d-cache-sets = <cpu6_dcs: 512>;
			d-cache-size = <cpu6_dcsz: 32768>;
			i-cache-block-size = <cpu6_icbs: 16>;
			i-cache-sets = <cpu6_ics: 512>;
			i-cache-size = <cpu6_icsz: 32768>;

			next-level-cache = <&L2>;
		};

		cpu7: cpu@7 {
			device_type = cpu7_devtype:"cpu";
			reg = <7>;
			status = "okay";
			compatible = "syntacore,scr9","riscv";
			riscv,isa = "rv64imafdc_sscofpmf";
			mmu-type = "riscv,sv39";
			clock-frequency = <cpu7_freq:0>;

			d-cache-block-size = <cpu7_dcbs: 16>;
			d-cache-sets = <cpu7_dcs: 512>;
			d-cache-size = <cpu7_dcsz: 32768>;
			i-cache-block-size = <cpu7_icbs: 16>;
			i-cache-sets = <cpu7_ics: 512>;
			i-cache-size = <cpu7_icsz: 32768>;

			next-level-cache = <&L2>;
		};
	};

	L2: l2-cache {
		compatible = "syntacore,cache";
		d-cache-line-size = <64>;
		d-cache-size = <524288>;
		i-cache-line-size = <64>;
		i-cache-size = <524288>;
	};
	
	L3: l3-cache {
		compatible = "syntacore,cache";
		d-cache-line-size = <64>;
		d-cache-size = <1048576>;
		i-cache-line-size = <64>;
		i-cache-size = <1048576>;
	};

	CPUx_intc: interrupt-controller {
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		compatible = "riscv,cpu-intc";
	};

	soc {
		#address-cells = <2>;
		#size-cells = <1>;
		compatible = "syntacore,scr9-soc";
		ranges;

		mtimer: timer@4010000 {
			compatible = "syntacore,machine-timer";
			reg = <0x0 0x4010000 0x2000>;
			interrupts = <7>;
			interrupt-parent = <&CPUx_intc>;
		};

		plic: interrupt-controller@6000000 {
			#interrupt-cells = <2>;
			compatible = "sifive,plic-1.0.0", "riscv,plic0";
			interrupt-controller;
			interrupts-extended = <&CPUx_intc 11>;	

			reg = <0x0 0x6000000 0x00001000
			0x0 0x6004000  0x00004000
			0x0 0x6200000  0x00040000 >;			
			reg-names = "prio", "irq_en", "reg";

			riscv,max-priority = <4>;
			riscv,ndev = <4>;
		};

		uart: serial@1e140000 {
			compatible = "ns16550";
			reg-shift = < 2 >;
			reg = <0x0 0x1e140000 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <60 1>; // IRQ PRIO
			current-speed = <115200>;
			status = "okay";
		};
		
		iccm: iccm@4020000 {
			compatible = "syntacore,iccm";
			reg = <0x0 0x4020000 0x2000>;
		};
	};
};
