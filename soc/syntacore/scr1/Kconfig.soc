# Kconfig - SCR1 SoC configuration options

# FIXME: non-privileged actually, dependent from Custom IC

config SOC_FAMILY_SCR1
	bool
	select RISCV
	select RISCV_PRIVILEGED
	select ATOMIC_OPERATIONS_C
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select SCR_IPIC

config SOC_SERIES_SCR1
	bool
	select SOC_FAMILY_SCR1

config SOC_FAMILY
	default "SCR1" if SOC_FAMILY_SCR1

config SOC_SERIES
	default "SCR1" if SOC_SERIES_SCR1

config SOC
	default "SCR1" if SOC_SCR1

config SOC_SCR1
	bool
	select SOC_SERIES_SCR1

rsource "../Kconfig"
