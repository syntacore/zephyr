# Kconfig - SCR7 SoC configuration options

config SOC_SERIES
	default "scr7" if SOC_SERIES_SCR7

config SOC_SERIES_SCR7
	bool
	select SOC_FAMILY_SYNTACORE
	
config SOC_SCR7_L2
	bool
	select RISCV
	select SOC_SERIES_SCR7
	select CPU_SCR7_V2
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	
config SOC
	default "SCR7 L2" if SOC_SCR7_L2
	