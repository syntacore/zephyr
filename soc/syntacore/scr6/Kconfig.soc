# Kconfig - SCR6 SoC configuration options

config SOC_SERIES
	default "scr6" if SOC_SERIES_SCR6

config SOC_SERIES_SCR6
	bool
	select SOC_FAMILY_SYNTACORE

config SOC_SCR6
	bool
	select RISCV
	select SOC_SERIES_SCR6
	select CPU_SCR6_V1
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	
config SOC
	default "SCR6" if SOC_SCR6
	