# Kconfig - SCR3 SoC configuration options

config SOC_SERIES
	default "scr3" if SOC_SERIES_SCR3

config SOC_SERIES_SCR3
	bool
	select SOC_FAMILY_SYNTACORE

config SOC_SCR3
	bool
	select RISCV
	select SOC_SERIES_SCR3
	select CPU_SCR3_V1
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	
config SOC_SCR3_L2
	bool
	select RISCV
	select SOC_SERIES_SCR3
	select CPU_SCR3_V2
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK

config SOC
	default "SCR3" if SOC_SCR3
	default "SCR3 L2" if SOC_SCR3_L2
