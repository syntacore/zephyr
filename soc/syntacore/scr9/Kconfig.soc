# Kconfig - SCR9 SoC configuration options

config SOC_FAMILY_SCR9
	bool
	select RISCV
	select RISCV_GP
	select RISCV_ISA_RV64I
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_D
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select 64BIT
	select RISCV_PRIVILEGED
	select CPU_HAS_FPU_DOUBLE_PRECISION
	select CPU_HAS_DCACHE
	select CPU_HAS_ICACHE
	select SCR_L1_CACHE
	select SCR_L2_CACHE
	select RISCV_HAS_PLIC
	select RISCV_EARLY_INIT_SECONDARY if (MP_MAX_NUM_CPUS > 1)

config SOC_FAMILY
	default "SCR9" if SOC_FAMILY_SCR9

config SOC_SERIES_SCR9_L2
	bool
	select SOC_FAMILY_SCR9

config SOC_SERIES_SCR9_L3
	bool
	select SOC_FAMILY_SCR9
	select SCR_L3_CACHE
	select SCR_MRT

config SOC_SERIES
	default "SCR9 L2" if SOC_SERIES_SCR9_L2
	default "SCR9 L3" if SOC_SERIES_SCR9_L3

config SOC_SCR9_L2
	bool
	select SOC_SERIES_SCR9_L2

config SOC_SCR9_L3
	bool
	select SOC_SERIES_SCR9_L3
	
config SOC
	default "SCR9 L2" if SOC_SCR9_L2
	default "SCR9 L3" if SOC_SCR9_L3
	
rsource "../Kconfig"