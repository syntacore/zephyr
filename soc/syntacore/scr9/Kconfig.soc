# Kconfig - SCR9 SoC configuration options

config SOC_SERIES
	default "scr9" if SOC_SERIES_SCR9

config SOC_SERIES_SCR9
	bool
	select SOC_FAMILY_SYNTACORE

config SOC_SCR9_L2
	bool
	select RISCV
	select SOC_SERIES_SCR9
	select CPU_SCR9_V1
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	
config SOC_SCR9_L3
	bool
	select RISCV
	select SOC_SERIES_SCR9
	select CPU_SCR9_V2
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	
config SOC
	default "SCR9 L2" if SOC_SCR9_L2
	default "SCR9 L3" if SOC_SCR9_L3
	