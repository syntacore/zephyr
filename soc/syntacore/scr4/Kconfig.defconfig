if CPU_SCR4

config RISCV_SOC_INTERRUPT_INIT
	default y
	
config ARCH_HAS_STACK_PROTECTION
	default n
	
config SRAM_REGION_PERMISSIONS
	default n

config ARCH_HAS_USERSPACE
	default n

config MINIMAL_LIBC_OPTIMIZE_STRING_FOR_SIZE
	default n

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 16384

config FPU
	default y

config FLOAT_HARD
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11
	
config MAX_IRQ_PER_AGGREGATOR
	default 4

config NUM_IRQS
	default 44 if SCR_IPIC
	default 139 if RISCV_HAS_PLIC
	
config ICACHE_LINE_SIZE
	default 16

config DCACHE_LINE_SIZE
	default 16
	
config TICKET_SPINLOCKS
	default y
	
config IPI_OPTIMIZE
	default n
	
DT_SCR_L2_PATH := $(dt_nodelabel_path,L2)
DT_SCR_L2_LINE_SIZE := $(dt_node_int_prop_int,$(DT_SCR_L2_PATH),d-cache-line-size)
	
config RISCV_MIN_STACK_OBJ_ALIGN_AND_SIZE
	default "$(DT_SCR_L2_LINE_SIZE)" if (SCR_L2_CACHE)
	default DCACHE_LINE_SIZE

config SPSC_PBUF_NO_CACHE
	default y

config CACHE_MANAGEMENT
	default y if SCR_L1_CACHE || SCR_L2_CACHE

endif # CPU_SCR4
