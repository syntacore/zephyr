# Kconfig - SCR4 SoC configuration options

config SOC_SERIES
	default "scr4" if SOC_SERIES_SCR4

config SOC_SERIES_SCR4
	bool
	select SOC_FAMILY_SYNTACORE

config SOC_SCR4
	bool
	select RISCV
	select SOC_SERIES_SCR4
	select CPU_SCR4_V1
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	
config SOC_SCR4_L2
	bool
	select RISCV
	select SOC_SERIES_SCR4
	select CPU_SCR4_V2
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK

config SOC
	default "SCR4" if SOC_SCR4
	default "SCR4 L2" if SOC_SCR4_L2
