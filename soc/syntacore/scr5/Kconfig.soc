# Kconfig - SCR5 SoC configuration options

config SOC_FAMILY_SCR5
	bool
	select RISCV
	select RISCV_GP
	select RISCV_PRIVILEGED
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_D
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select CPU_HAS_DCACHE
	select CPU_HAS_ICACHE
	select SCR_L1_CACHE
	select SCR_L2_CACHE
	select SCR_MPU
	select RISCV_HAS_PLIC
	select RISCV_EARLY_INIT_SECONDARY if (MP_MAX_NUM_CPUS > 1)
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK

config SOC_FAMILY
	default "SCR5" if SOC_FAMILY_SCR5

config SOC_SERIES_SCR5_RV32
	bool
	select SOC_FAMILY_SCR5
	select RISCV_ISA_RV32I
	
config SOC_SERIES_SCR5_RV64
	bool
	select SOC_FAMILY_SCR5
	select 64BIT
	select RISCV_ISA_RV64I
	select CPU_HAS_FPU_DOUBLE_PRECISION

config SOC_SERIES
	default "SCR5 RV32" if SOC_SERIES_SCR5_RV32
	default "SCR5 RV64" if SOC_SERIES_SCR5_RV64

config SOC_SCR5_RV32
	bool
	select SOC_SERIES_SCR5_RV32

config SOC_SCR5_RV64
	bool
	select SOC_SERIES_SCR5_RV64

config SOC
	default "SCR5 RV32" if SOC_SCR5_RV32
	default "SCR5 RV64" if SOC_SCR5_RV64

rsource "../Kconfig"
