# Kconfig - SCR5 SoC configuration options

config SOC_SERIES
	default "scr5" if SOC_SERIES_SCR5

config SOC_SERIES_SCR5
	bool
	select SOC_FAMILY_SYNTACORE

config SOC_SCR5_RV32
	bool
	select RISCV
	select SOC_SERIES_SCR5
	select CPU_SCR5_V1
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	
config SOC_SCR5_RV64
	bool
	select RISCV
	select SOC_SERIES_SCR5
	select CPU_SCR5_V2
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK

config SOC_SCR5_ACLINT
	bool
	select RISCV
	select SOC_SERIES_SCR5
	select CPU_SCR5_V3
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK

config SOC
	default "SCR5 RV32" if SOC_SCR5_RV32
	default "SCR5 RV64" if SOC_SCR5_RV64
	default "SCR5 ACLINT" if SOC_SCR5_ACLINT
