# Kconfig - RISCV32_SCR1 SoC implementation

# FIXME: non-privileged actually, dependent from Custom IC
config SOC_SERIES_RISCV32_SCR1
	bool "Syntacore SCR1-based SoC implementation"
	select RISCV
	select RISCV_PRIVILEGED
	select ATOMIC_OPERATIONS_C
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select SOC_FAMILY_SYNTACORE_SCR
	select SCR_IPIC
	help
		Enable support for Syntacore SCR1-based SoC
