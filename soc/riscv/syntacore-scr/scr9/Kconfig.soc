# Kconfig - RISCV64_SCR9 SoC configuration options

choice
prompt "Syntacore SCR9-based SoC implementation"
depends on SOC_SERIES_RISCV64_SCR9

config SOC_RISCV64_SCR9_L2
	bool "SoC implementation based on SCR9 L2"


endchoice
