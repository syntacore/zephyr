config SOC_FAMILY
	string
	default "riscv-privileged/syntacore-scr" if SYNTACORE_SCR
	default "riscv-privileged"
	depends on SOC_FAMILY_RISCV_PRIVILEGED

source "soc/riscv/riscv-privileged/syntacore-scr/*/Kconfig.defconfig.series"
