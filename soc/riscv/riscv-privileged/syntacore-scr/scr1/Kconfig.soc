choice
prompt "Syntacore SCR1-based SoC implementation"
depends on SOC_SERIES_RISCV32_SCR1

config SOC_RISCV32_SCR1
	bool "Syntacore SCR1-based SoC implementation"

config SOC_ELCT_SCU
    bool "ELCT SCU SoC implementation"
    select HAS_SPI_DW

endchoice
