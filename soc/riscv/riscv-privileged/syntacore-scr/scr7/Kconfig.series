config SOC_SERIES_RISCV64_SCR7
	bool "SoC implementation based on SCR7"
	select RISCV
	select RISCV_GP
	select RISCV_ISA_RV64I
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_D
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select 64BIT
	select SOC_FAMILY_RISCV_PRIVILEGED
	select CPU_HAS_FPU_DOUBLE_PRECISION
	select SYNTACORE_SCR
	select CPU_HAS_DCACHE
	select CPU_HAS_ICACHE
	select SCR_L1_CACHE
	select SCR_L2_CACHE
	select RISCV_EARLY_INIT_SECONDARY if (MP_MAX_NUM_CPUS > 1)
	help
		Enable support for Syntacore SCR7-based SoC
